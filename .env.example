# Copy to .env (never commit it).
MACROVOICE_API_TOKEN=change-me          # the Android app sends this as a Bearer token
MACROVOICE_TZ=Europe/Amsterdam
# ANTHROPIC_API_KEY=                    # optional: enables the AI fallback for unknown foods
# MACROVOICE_AI_MODEL=claude-haiku-5-5
# USDA_API_KEY=                         # optional: needed for the `usda` worker job
WORKER_JOBS=off-api                     # comma separated: off-api,usda
WORKER_INTERVAL_HOURS=168
OFF_PAGES=50
OFF_COUNTRY=netherlands
